// [BTDR:FILE.FOG.SCATTER] fog_scatter.comp — volumetric fog pass 1 (ported from ue5r): per-froxel density and
// in-scattered light. Compute shader, one thread per froxel ([BTDR:BUILD.FOG]). Output is a 3D texture aligned
// with the camera frustum (x, y = screen, z = depth slice).
// inputs: 2D 0 sun shadow map (linear distance, shadow_src), 2D 1 sharp environment, 3D 0 environment atlas
// output: rgb = scattering coefficient x incoming light, a = extinction coefficient
// uFog: x density, y height falloff, z base height, w anisotropy g; uFog2: x near, y far, z ambient, w noise
// uFog3: rgb albedo, w on
#define ENV_SHARP sTD2DInputs[1]
#define ENV_ATLAS sTD3DInputs[0]
//#include env_lookup
layout (local_size_x = 8, local_size_y = 8) in;
// [BTDR:FOG.SLICES] exponential slice distribution: thin slices near the camera
float sliceDepth(float s) { return uFog2.x * pow(uFog2.y / uFog2.x, s); }
float phaseHG(float c, float g)
{
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * PI * pow(max(1.0 + g2 - 2.0 * g * c, 1e-4), 1.5));
}
// [BTDR:FOG.SHADOW] (0.7.3) same contact-hardening penumbra as the surfaces ([BTDR:LIGHT.SHADOW] sunShadow):
// blocker search -> penumbra radius grows with the distance to the blocker -> PCF. Until 0.7.2 the fog used a fixed
// ~1-texel kernel, so the shafts behind thin occluders (blinds, grilles) stayed razor sharp metres away while the
// floor shadows of the same slats were soft: every light sheet showed as a hard band (the "diagonal streaks").
// Fog Shadow Blur (uDOF2.w) scales the penumbra relative to the surfaces (1 = identical, 0 = one hard tap).
// Taps are rotated per froxel and per frame; fog_accum averages them ([BTDR:FOG.QUALITY]).
float sunVisibility(vec3 p, float rnd)
{
    if (uSunPos.w < 0.5) return 1.0;
    vec3 rel = p - uSunPos.xyz;
    vec2 suv = vec2(dot(rel, uSunRight.xyz), dot(rel, uSunUp.xyz)) / uSunRight.w + 0.5;
    if (suv.x < 0.0 || suv.x > 1.0 || suv.y < 0.0 || suv.y > 1.0) return 1.0;
    float depth = dot(uSunPos.xyz - p, uSunDir.xyz);
    float texel = 1.0 / uTD2DInfos[0].res.z;
    float wtex = uSunRight.w * texel;                       // world size of one shadow texel
    float bias = UM(0.01) + wtex * 1.5;
    float soft = max(uSunColor.w, 0.0) * uDOF2.w;
    if (soft <= 0.0) {
        float d = textureLod(sTD2DInputs[0], suv, 0.0).r;
        return (d > 0.001 && d < depth - bias) ? 0.0 : 1.0;
    }
    float ang = rnd * 6.2831853;
    float search = max(UM(0.024) * soft, wtex * 2.0) / uSunRight.w;
    float blockers = 0.0, bsum = 0.0;
    for (int i = 0; i < 8; i++) {
        float r = sqrt((float(i) + 0.5) / 8.0);
        float th = float(i) * 2.39996323 + ang;
        float d = textureLod(sTD2DInputs[0], suv + vec2(cos(th), sin(th)) * r * search, 0.0).r;
        if (d > 0.001 && d < depth - bias) { bsum += d; blockers += 1.0; }
    }
    if (blockers < 0.5) return 1.0;
    float pen = clamp((depth - bsum / blockers) * 0.0376 * soft, wtex * 1.2, max(UM(0.0273) * soft, wtex * 1.2)) / uSunRight.w;
    float lit = 0.0;
    for (int i = 0; i < 12; i++) {
        float r = sqrt((float(i) + 0.5) / 12.0);
        float th = float(i) * 2.39996323 + ang + 1.3;
        float d = textureLod(sTD2DInputs[0], suv + vec2(cos(th), sin(th)) * r * pen, 0.0).r;
        lit += (d > 0.001 && d < depth - bias) ? 0.0 : 1.0;
    }
    return lit / 12.0;
}
void main()
{
    loadUB();
    ivec3 gid = ivec3(gl_GlobalInvocationID);
    ivec3 sz = ivec3(uTDOutputInfo.res.zw, int(uTDOutputInfo.depth.y + 0.5));
    if (any(greaterThanEqual(gid, sz))) return;
    // [BTDR:FOG.JITTER] a different random point inside the froxel every frame (all three axes); fog_accum.comp
    // ([BTDR:FOG.ACCUM]) averages them, which smooths both the noise and the froxel steps of light shafts
    vec2 hk = vec2(gid.xy) + float(gid.z) * 97.0 + uFrame.x * 13.1;
    // 0.7.3: Fog Jitter scales only the screen-plane part. The depth part always spans the whole slice: a slice is
    // tens of centimetres thick, thinner light sheets (blinds) alias against the slices when only part of each
    // slice is sampled, and the moire shows as broad diagonal bands across the fog that do not follow the light
    vec3 j = (vec3(hash12(hk), hash12(hk + 41.7), hash12(hk + 83.3)) - 0.5) * vec3(uGI.w, uGI.w, 1.0);
    float rnd = hash12(hk.yx + 17.3);
    vec3 uvw = (vec3(gid) + 0.5 + j) / vec3(sz);
    vec2 ndc = uvw.xy * 2.0 - 1.0;
    vec3 ray = uCamFwd.xyz + ndc.x * uCamFwd.w * uCamRight.xyz + ndc.y * uCamFwd.w / uClip.z * uCamUp.xyz;
    vec3 p = uCamPos.xyz + ray * sliceDepth(clamp(uvw.z, 0.0, 1.0));   // ray has unit forward component
    // [BTDR:FOG.DENSITY] exponential height fog + optional animated noise
    float dens = uFog.x * exp(-uFog.y * max(p.y - uFog.z, 0.0));
    float n = TDSimplexNoise(vec4(p * (1.3 * uUnit.y), uFrame.w * 0.05)) * 0.5 + 0.5;
    dens *= mix(1.0, 0.4 + 1.2 * n, uFog2.w);
    vec3 V = normalize(ray);
    vec3 sun = uSunColor.rgb * uSunDir.w * sunVisibility(p, rnd) * phaseHG(dot(V, normalize(uSunDir.xyz)), uFog.w);
    // ambient: average sky radiance (irradiance / PI of up and down), isotropic phase 1 / 4PI x 4PI solid angle
    vec3 amb = 0.5 * (envIrradiance(vec3(0.0, 1.0, 0.0)) + envIrradiance(vec3(0.0, -1.0, 0.0))) * uFog2.z;
    TDImageStoreOutput(0, uvec3(gid), vec4(uFog3.rgb * dens * (sun + amb), dens));
}
