// [BTDR:FILE.SCENES.SWIRL] swirl.comp — GLSL POP of the particle scene (make_scenes.py, SCENES.PARTICLES).
// Chladni figures: the particles are sand on an invisible square plate floating in the air. A standing wave of
// mode (n, m) leaves the sand on its nodal lines, f(x, y) = cos(n pi x) cos(m pi y) +- cos(m pi x) cos(n pi y) = 0.
// The mode changes every CH_BAR seconds (on the music's bar lines): the sand jumps off the old lines and lands
// on the new ones. The bass shakes the plate (sand spread around the lines), the kick makes it hop.
// Stateless: every particle is placed from its id, the time uTime.x and the audio features uAudio
// (x bass, y mid, z high, w kick envelope), so any frame can be rendered on its own (frame-exact recording).
// Writes P, Color (white emission, brightness only) and PointScale (instance size).
// uForm.x 0..1 gathers the particles into the text drawn in sText (a Text TOP): every particle samples a
// target point inside the letters and flies there with its own delay. uForm.yzw = text plane width, centre y, z.
#define CH_SIZE 6.0          // plate edge (scene units)
#define CH_Y 0.8             // plate height: close to the mirror floor, so the screen-space reflection finds the grains
#define CH_BAR 2.0           // seconds per figure
#define CH_MOVE 0.9          // seconds the sand takes to settle on the new figure
float hsh(uint n)
{
    n = (n << 13U) ^ n;
    n = n * (n * n * 15731U + 789221U) + 1376312589U;
    return float(n & 0x7fffffffU) / float(0x7fffffff);
}
vec3 noise3(vec3 p, float t)
{
    return vec3(TDSimplexNoise(vec4(p, t)), TDSimplexNoise(vec4(p + vec3(17.1, 3.7, 9.2), t)),
                TDSimplexNoise(vec4(p + vec3(5.3, 21.9, 13.4), t)));
}
// mode table: n, m, sign (+1 / -1 picks the symmetric / antisymmetric combination)
vec3 chMode(int k)
{
    const vec3 M[12] = vec3[12](vec3(1, 2, -1), vec3(2, 3, 1), vec3(1, 4, -1), vec3(3, 4, 1), vec3(2, 5, -1),
                                vec3(3, 5, 1), vec3(1, 6, -1), vec3(4, 5, 1), vec3(2, 7, -1), vec3(5, 6, 1),
                                vec3(3, 7, -1), vec3(4, 7, 1));
    return M[((k % 12) + 12) % 12];
}
// plate function and its gradient, x, y in [0, 1]
vec3 chF(vec2 q, vec3 md)
{
    float PI_ = 3.14159265;
    float a = md.x * PI_, b = md.y * PI_;
    float c1 = cos(a * q.x), s1 = sin(a * q.x), c2 = cos(b * q.y), s2 = sin(b * q.y);
    float c3 = cos(b * q.x), s3 = sin(b * q.x), c4 = cos(a * q.y), s4 = sin(a * q.y);
    float f = c1 * c2 + md.z * c3 * c4;
    float fx = -a * s1 * c2 - md.z * b * s3 * c4;
    float fy = -b * c1 * s2 - md.z * a * c3 * s4;
    return vec3(f, fx, fy);
}
// Newton steps from the particle's home point onto the nearest nodal line
vec2 chProject(vec2 q, vec3 md)
{
    for (int i = 0; i < 8; i++) {
        vec3 f = chF(q, md);
        float g2 = dot(f.yz, f.yz);
        if (g2 < 1e-6) break;
        q -= f.x * f.yz / g2 * 0.85;
        q = clamp(q, vec2(0.0), vec2(1.0));
    }
    return q;
}
void main()
{
    const uint id = TDIndex();
    if (id >= TDNumElements()) return;
    float t = uTime.x;
    float bass = uAudio.x, mid = uAudio.y, high = uAudio.z, kick = uAudio.w;
    float a = hsh(id * 5U + 1U), b = hsh(id * 5U + 2U), c = hsh(id * 5U + 3U), d = hsh(id * 5U + 4U), e = hsh(id * 5U + 5U);
    vec3 p;
    vec3 col;
    float sc = 0.0055 * (0.55 + 0.9 * d);
    if (e < 0.95) {
        // the sand: settled on the nodal lines of the current mode, moving over from the previous one
        int k = int(floor(t / CH_BAR));
        float ph = clamp((t - float(k) * CH_BAR) / CH_MOVE - c * 0.25, 0.0, 1.0);   // staggered landing
        float s = ph * ph * (3.0 - 2.0 * ph);
        vec2 home = vec2(a, b);
        vec2 q0 = chProject(home, chMode(k - 1));
        vec2 q1 = chProject(home, chMode(k));
        vec2 q = mix(q0, q1, s);
        // sand that did not reach a line (Newton stopped far from it) stays dim
        float miss = abs(chF(q1, chMode(k)).x);
        // the plate shakes with the bass: grains spread across the line, the kick makes them hop
        // spread around the line: most grains close (sum of two uniforms ~ a soft profile), a few stray ones
        vec2 r2 = vec2(hsh(id * 7U + 11U) + hsh(id * 7U + 13U), hsh(id * 7U + 12U) + hsh(id * 7U + 14U)) - 1.0;
        vec2 jit = r2 * (0.007 + 0.02 * bass) * (e > 0.82 ? 4.0 : 1.0);
        q += jit;
        float hop = sin(3.14159265 * s) * (0.25 + 0.5 * d) + kick * 0.05 * d;
        p = vec3((q.x - 0.5) * CH_SIZE, CH_Y + hop + (d - 0.5) * 0.015, (q.y - 0.5) * CH_SIZE);
        float lum = 3.6 * (0.6 + 0.8 * d) * (1.0 - smoothstep(0.05, 0.4, miss) * 0.8);
        lum *= 0.8 + 0.5 * bass + 0.6 * sin(3.14159265 * s);
        col = vec3(lum);
    } else {
        // dust drifting around the plate, flashing on the highs
        vec3 dir = normalize(vec3(a - 0.5, (b - 0.5) * 0.6, c - 0.5) + 1e-4);
        float rr = 4.2 + 3.0 * d + 0.4 * kick;
        p = vec3(dir.x * rr, CH_Y + dir.y * rr * 0.7, dir.z * rr);
        p += noise3(p * 0.3, t * 0.08) * 0.5;
        float tw = step(0.9, fract(d * 37.0 + t * (0.3 + a)));
        col = vec3(2.0) * (0.25 + 6.0 * high * tw);
        sc *= 0.7;
    }
    p.y = max(p.y, 0.03);
    // [SWIRL.TEXT] gather into the letters
    float hidden = 0.0;
    if (uForm.x > 0.0) {
        vec2 uv = vec2(0.5);
        hidden = 1.0;
        for (uint k = 0U; k < 24U; k++) {
            vec2 q = vec2(hsh(id * 97U + k * 2U + 11U), hsh(id * 97U + k * 2U + 12U));
            if (textureLod(sText, q, 0.0).r > 0.5) { uv = q; hidden = 0.0; break; }
        }
        vec2 ts = vec2(textureSize(sText, 0));
        float w = uForm.y, h = uForm.y * ts.y / ts.x;
        vec3 tgt = vec3((uv.x - 0.5) * w, uForm.z + (uv.y - 0.5) * h, uForm.w + (d - 0.5) * 0.06);
        float f = clamp(uForm.x * 1.7 - e * 0.7, 0.0, 1.0);
        f = f * f * (3.0 - 2.0 * f);
        p = mix(p, tgt, f);
        col = mix(col, vec3(6.0) * (0.7 + 0.6 * bass), f * (1.0 - hidden));
        sc *= mix(1.0, 1.0 - hidden, f) * mix(1.0, 0.8, f);
    }
    P[id] = p;
    col *= 0.24;
    Color[id] = vec4(col, 1.0);
    PointScale[id] = sc * (1.0 + 0.4 * bass);
}
